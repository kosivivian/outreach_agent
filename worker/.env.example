# Worker (Railway) environment
ANTHROPIC_API_KEY=sk-...
APIFY_API_KEY=apify_api_...          # TEAM account token, not personal
APIFY_ACTOR_ID=code_crafter/leads-finder
APIFY_PERSONAL_BUDGET_USD=5          # your share of the cohort budget; discovery refuses to run past it
APIFY_MAX_CHARGE_PER_RUN_USD=0.5     # hard cap passed to every actor run (actor minimum is 0.50)
FIRECRAWL_API_KEY=fc..
# Scrapes per minute; set to your Firecrawl plan's limit (free = 10)
FIRECRAWL_RPM=10
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=sb..        # service role: worker only, never ship to the browser
RESEND_API_KEY=re..
ALERT_FROM_EMAIL=
OPS_ALERT_EMAIL=ops@mailer.kosinebolisa.com
APP_URL=http://localhost:3000
WORKER_SECRET=change-me              # shared with the Next.js app
AGENT_MODEL=claude-sonnet-4-6
# Cheap model for the pre-scrape company screen
SCREEN_MODEL=claude-haiku-4-5-20251001
PORT=8080
